{
  "name": "adaptivecard-js",
  "description": "Fluent TypeScript builder that programmatically constructs Microsoft Adaptive Card (v1.6) JSON payloads.",
  "version": "1.0.1",
  "license": "MIT",
  "keywords": [
    "adaptivecards",
    "adaptive-cards",
    "microsoft-teams",
    "teams",
    "json",
    "builder",
    "typescript"
  ],
  "homepage": "https://github.com/garis-kode/adaptivecard-js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/garis-kode/adaptivecard-js.git"
  },
  "bugs": {
    "url": "https://github.com/garis-kode/adaptivecard-js/issues"
  },
  "author": {
    "name": "Garis Kode",
    "email": "office@gariskode.com"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.0"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "test": "bun test",
    "test:pack": "bun run scripts/test-pack.ts",
    "typecheck": "bun --check",
    "fmt": "bun fmt",
    "fmt:check": "bun fmt --check",
    "check": "bun run fmt:check && bun run typecheck && bun test && bun run build",
    "prepack": "bun run build",
    "prepublishOnly": "bun run check && bun run test:pack"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7"
  }
}
